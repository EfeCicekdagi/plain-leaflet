# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Anahtar: https://aistudio.google.com/apikey (herkes kendi ücretsiz anahtarını alır)
GEMINI_API_KEY=

# 1 yapılırsa analyze() modeli çağırmaz, mock/analyze_output.json döndürür.
USE_MOCK=0

# İsteğe bağlı: model adları (varsayılan gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_DOGRULAYICI_MODEL=gemini-2.5-flash-lite
