# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Anahtar: https://aistudio.google.com/apikey (herkes kendi ücretsiz anahtarını alır)
GEMINI_API_KEY=

# 1 yapılırsa analyze() modeli çağırmaz, mock/analyze_output.json döndürür.
USE_MOCK=0

# İsteğe bağlı: model adları (varsayılan gemini-3.8-flash). Ücretsiz günlük kota model başına ayrıdır.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_DOGRULAYICI_MODEL=gemini-3.5-flash-lite
# Gizli düşünme bütçesi: 0 = kapalı (varsayılan, hızlı), none = model varsayılanı
# GEMINI_DUSUNME=0
