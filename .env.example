# Copy this file to .env: cp .env.example .env
# Free API key: https://aistudio.google.com/apikey (everyone uses their own)
GEMINI_API_KEY=

# 1 = analyze() does not call the model and returns mock/analyze_output.json.
USE_MOCK=0

# Optional: model names (default gemini-3.6-flash). The free daily quota is per model.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_DOGRULAYICI_MODEL=gemini-3.5-flash-lite
# Used once when the main model is busy (503) or out of quota (429). Empty = off.
# GEMINI_YEDEK_MODEL=gemini-3.5-flash
# Hidden thinking budget: 0 = off (default, faster), none = model default
# GEMINI_DUSUNME=0
